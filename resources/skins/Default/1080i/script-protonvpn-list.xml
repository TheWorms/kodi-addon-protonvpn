<?xml version="1.0" encoding="UTF-8"?>
<!-- Fenêtre de liste des exceptions (lib/exceptions_ui.py) : icône de l'addon à
     gauche, petite icône de la méthode à droite, boutons en bas. -->
<window type="dialog">
  <defaultcontrol always="true">100</defaultcontrol>
  <coordinates>
    <system>1</system>
    <posx>0</posx>
    <posy>0</posy>
  </coordinates>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>pv_dim.png</texture>
      <colordiffuse>CC000000</colordiffuse>
    </control>
    <control type="image">
      <left>460</left><top>130</top><width>1000</width><height>820</height>
      <texture border="20">pv_panel.png</texture>
    </control>
    <control type="label" id="1">
      <left>505</left><top>160</top><width>910</width><height>44</height>
      <font>font14</font><textcolor>FFFFFFFF</textcolor>
    </control>
    <control type="image">
      <left>505</left><top>218</top><width>910</width><height>4</height>
      <texture>pv_accent.png</texture>
    </control>

    <control type="label" id="300">
      <left>505</left><top>420</top><width>910</width><height>120</height>
      <font>font13</font><align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline>
      <textcolor>FF9AA0AA</textcolor>
      <visible>Integer.IsEqual(Container(100).NumItems,0)</visible>
    </control>

    <control type="list" id="100">
      <left>490</left><top>238</top><width>940</width><height>576</height>
      <onup>100</onup>
      <ondown>201</ondown>
      <scrolltime>150</scrolltime>
      <orientation>vertical</orientation>
      <itemlayout height="82" width="940">
        <control type="image">
          <left>14</left><top>13</top><width>56</width><height>56</height>
          <aspectratio>keep</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <left>88</left><top>8</top><width>760</width><height>38</height>
          <font>font13</font><textcolor>FFFFFFFF</textcolor>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <left>88</left><top>44</top><width>760</width><height>30</height>
          <font>font12</font><textcolor>FF9AA0AA</textcolor>
          <label>$INFO[ListItem.Label2]</label>
        </control>
        <control type="image">
          <left>886</left><top>26</top><width>30</width><height>30</height>
          <aspectratio>keep</aspectratio>
          <texture>$INFO[ListItem.Property(method_icon)]</texture>
        </control>
      </itemlayout>
      <focusedlayout height="82" width="940">
        <control type="image">
          <left>0</left><top>2</top><width>940</width><height>78</height>
          <texture border="10">pv_accent.png</texture>
          <colordiffuse>55FFFFFF</colordiffuse>
          <visible>Control.HasFocus(100)</visible>
        </control>
        <control type="image">
          <left>14</left><top>13</top><width>56</width><height>56</height>
          <aspectratio>keep</aspectratio>
          <texture>$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <left>88</left><top>8</top><width>760</width><height>38</height>
          <font>font13</font><textcolor>FFFFFFFF</textcolor>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <left>88</left><top>44</top><width>760</width><height>30</height>
          <font>font12</font><textcolor>FFDDE3EA</textcolor>
          <label>$INFO[ListItem.Label2]</label>
        </control>
        <control type="image">
          <left>886</left><top>26</top><width>30</width><height>30</height>
          <aspectratio>keep</aspectratio>
          <texture>$INFO[ListItem.Property(method_icon)]</texture>
        </control>
      </focusedlayout>
    </control>

    <control type="button" id="201">
      <left>505</left><top>848</top><width>590</width><height>66</height>
      <font>font13</font><align>center</align><aligny>center</aligny>
      <textcolor>FFDDE3EA</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
      <texturefocus border="10">pv_accent.png</texturefocus>
      <texturenofocus border="10" colordiffuse="40FFFFFF">pv_accent.png</texturenofocus>
      <onup>100</onup><onright>202</onright><onleft>202</onleft>
    </control>
    <control type="button" id="202">
      <left>1115</left><top>848</top><width>300</width><height>66</height>
